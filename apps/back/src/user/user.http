@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NywiZW1haWwiOiJqb2huQGV4YW1wbGUuY29tIiwicm9sIjoxLCJuYW1lIjoiSm9obiBEb2UiLCJpYXQiOjE3OTIxODg5NTEsImV4cCI6MTc5Mjc5Mzc1MX0.cZjZi7FF_oCvhdo3O6Ecn61ff2xHpys_XZyKMDQda0Q
@id = 7

### Get a user
GET {{baseUrl}}/{{id}}
Authorization: Bearer {{authToken}}

### List users
GET {{baseUrl}}
Authorization: Bearer {{authToken}}

### Create a user
POST {{baseUrl}}
Content-Type: application/json
{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "Abcd!123456789",
  "address": "Calle 68 Sur #49-21",
  "phone": "+573001234567"
}

### Update a user
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe 2",
  "email": "john@example.com",
  "eco_points": 2
}

### Delete a user
DELETE {{baseUrl}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}