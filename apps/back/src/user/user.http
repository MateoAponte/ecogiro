@baseUrl = http://localhost:3000/api/v1/user
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NiwiZW1haWwiOiJqb2huQGV4YW1wbGUuY29tIiwicm9sIjoxLCJuYW1lIjoiSm9obiBEb2UiLCJpYXQiOjE3OTIxNzk0NzYsImV4cCI6MTc5Mjc4NDI3Nn0.vh7S5ugcl5RaaYw2I7CbTmK8y_lx4tLu_fBht9qj-m4
@id = 6

### Get a user
GET {{baseUrl}}/{{id}}
Authorization: Bearer {{authToken}}

### List users
GET {{baseUrl}}
Authorization: Bearer {{authToken}}

### Create a user
POST {{baseUrl}}
Content-Type: application/json
{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "Abcd!123456789",
  "address": "Calle 68 Sur #49-21",
  "phone": "+573001234567"
}

### Update a user
PATCH {{baseUrl}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "John Doe 2",
  "email": "john@example.com",
  "password": "Abcd!123456789"
}

### Delete a user
DELETE {{baseUrl}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}